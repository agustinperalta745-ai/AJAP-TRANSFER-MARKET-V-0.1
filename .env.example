DISCORD_TOKEN=pegá_tu_token_solo_en_el_host
DISCORD_CLIENT_ID=1541608838032265238
DISCORD_GUILD_ID=1501062815920816360

# API móvil AJPA (solo lectura). En producción se habilita explícitamente.
AJPA_MOBILE_API_ENABLED=0
# Si se omite, usa DISCORD_GUILD_ID. Permite fijar qué liga expone la app.
AJPA_MOBILE_GUILD_ID=1501062815920816360
# Railway entrega PORT automáticamente; esto sirve solo para desarrollo local.
AJPA_MOBILE_API_PORT=8080

# Liga automática: OCR.Space lee las capturas de resultado/goleadores.
# La clave real se configura únicamente en Railway/host; nunca se sube al repo.
OCR_SPACE_API_KEY=pegá_tu_api_key_de_ocr_space_solo_en_el_host
# Engine 2 usa la cuota gratuita grande; Engine 3 queda como segundo intento
# únicamente cuando la primera lectura no alcanza.
AJAP_OCRSPACE_ENGINE=2
AJAP_OCRSPACE_FALLBACK_ENGINE=3
AJAP_OCRSPACE_RESULT_CONFIDENCE=0.80

# Compatibilidad: otras funciones históricas del proyecto todavía pueden usar
# OpenAI fuera del nuevo lector de resultados. El flujo principal de capturas ya
# no depende de esta clave.
OPENAI_API_KEY=pegá_tu_api_key_solo_en_el_host
OPENAI_VISION_MODEL=gpt-5.4-mini
AJAP_LEAGUE_VISION_CONFIDENCE=0.80
